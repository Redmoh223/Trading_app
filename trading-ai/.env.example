# Trading AI Environment Configuration
# Copy to .env and fill in your values

# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Trading Mode (paper | live) - DEFAULT: paper for safety
TRADING_MODE=paper

# Risk Limits
MAX_POSITION_SIZE_USD=1000
MAX_DAILY_LOSS_USD=500
MAX_PORTFOLIO_RISK_PCT=2
MAX_CONCURRENT_POSITIONS=5
KILL_SWITCH_DAILY_LOSS_PCT=5

# Broker API (example - Alpaca/Interactive Brokers/etc)
BROKER_API_KEY=your_api_key_here
BROKER_API_SECRET=your_api_secret_here
BROKER_BASE_URL=https://paper-api.alpaca.markets
BROKER_WS_URL=wss://stream.data.alpaca.markets/v2/iex

# ML Model
ML_MODEL_PATH=./python/ml/models/lstm_model.h5
ML_INFERENCE_INTERVAL_MS=100
ML_CONFIDENCE_THRESHOLD=0.7

# Symbols to trade
TRADE_SYMBOLS=AAPL,MSFT,GOOGL,TSLA,SPY,QQQ

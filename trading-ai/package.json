{
  "name": "trading-ai",
  "version": "1.0.0",
  "description": "Autonomous trading AI system with paper trading, risk management, and ML signal engine",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');fs.cpSync('src/server/public','dist/server/public',{recursive:true});\"",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "backtest": "ts-node src/scripts/run-backtest.ts"
  },
  "keywords": [
    "trading",
    "ai",
    "algorithmic",
    "backtesting",
    "risk-management"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "zod": "^3.22.4",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1",
    "csv-parse": "^5.5.3",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "@types/uuid": "^9.0.7",
    "@types/jest": "^29.5.11",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.16",
    "@types/cors": "^2.8.17"
  }
}
